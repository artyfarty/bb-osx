@@ -22,6 +22,43 @@
 int __resized_curses;
 static int uninitcurses;
 
+/* Frame synchronization.
+ *
+ * The stdout driver rewrote the whole screen every frame with no
+ * synchronization, so it tore and flickered badly. This curses driver wraps
+ * each frame in the "synchronized update" escape pair:
+ *
+ *     \e[?2026h   begin  (terminal buffers all subsequent output)
+ *     ... frame ...
+ *     \e[?2026l   end    (terminal presents the buffered frame atomically)
+ *
+ * Terminals that implement the protocol (Ghostty, iTerm2, kitty, WezTerm,
+ * Alacritty, xterm) buffer the update and paint it at the retrace, so frames
+ * never tear. Terminals that don't know the mode ignore it, so emitting it
+ * unconditionally is safe. If the termcap also provides v501 (a literal
+ * wait-for-vertical-retrace), that is emitted first as a complement. */
+static int   __curses_sync = 1;
+static const char *__curses_v501;
+
+static void curses_sync_begin(void)
+{
+	if (__curses_v501) {
+		putp(__curses_v501);
+		fflush(stdout);
+	}
+	if (__curses_sync) {
+		putp("\033[?2026h");
+		fflush(stdout);
+	}
+}
+static void curses_sync_end(void)
+{
+	if (__curses_sync) {
+		putp("\033[?2026l");
+		fflush(stdout);
+	}
+}
+
